          - /webdata/
        strip_path: true

  # =========================================================================
  # RUTAS INTERNAS S2S (Service-to-Service) — Autenticación por API Key
  # =========================================================================

  # S2S: Stock Service (interno)
  - name: internal-stock-service
    url: http://mc-stock-service:8080
    routes:
      - name: internal-stock-route
        paths:
          - /internal/stock/
        strip_path: true

  # S2S: PIM Service (interno)
