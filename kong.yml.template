        strip_path: true

  # Servicio Sales - HITO v0.5 (HTTP Routes Alignment)
  - name: sales-service
    url: http://sales-service:8080
    routes:
      - name: sales-route
        paths:
          - /sales/
        strip_path: true

  # Customer Service (POS-SALE-02)
  - name: customer-service
    url: http://mc-customer-service:8080
    routes:
      - name: customer-route
        paths:
          - /customers/
        strip_path: true

  # Payment Method Service (POS-SALE-02)
  - name: payment-method-service
    url: http://mc-payment-method-service:8080
    routes:
      - name: payment-method-route
        paths:
          - /payment-methods/
        strip_path: true

  # Servicio Marketplace (funcionalidad dentro del PIM)
  - name: marketplace-service
    url: http://mc-pim-service:8090/api/v1
    routes:
      - name: marketplace-route
        paths:
          - /marketplace/
        strip_path: false
  # Servicio Onboarding
  - name: onboarding-service
    url: http://mc-onboarding-service:8110/api/v1/onboarding
    routes:
      - name: onboarding-route
        paths:
          - /onboarding/api/v1/
        strip_path: true

  # Servicio Notification
  - name: notification-service
    url: http://mc-notification-service:8282
    routes:
      - name: notification-route
        paths:
          - /notification/
        strip_path: true

  # Servicio Tenant (Configuración por Tenant)
  - name: tenant-service
    url: http://mc-tenant-service:8120
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: tenant-route
        paths:
          - /tenant
        strip_path: true
      # Ruta específica para bootstrap (solo servicios internos)
      - name: tenant-bootstrap-route
        paths:
          - /tenant/api/v1/tenant/bootstrap
        strip_path: false
        methods:
          - POST
        plugins:
          - name: acl
            config:
              allow:
                - "service-internal"
              hide_groups_header: true

  # Frontend CRM
  - name: crm-frontend
    url: http://frontend-activo-crm:3000
    routes:
      - name: crm-frontend-route
        paths:
          - /crm/
        strip_path: true
  
  # AI Gateway Service (Autenticación flexible: JWT o API Key)
  - name: ai-gateway-service
    url: http://mc-commerce-ai-service:8000
    connect_timeout: 60000
    write_timeout: 120000
    read_timeout: 120000
    retries: 3
    routes:
      - name: ai-gateway-route
        paths:
          - /ai-gateway/
          - /ai/
        strip_path: true
        protocols:
          - http
          - https
        preserve_host: false
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-API-Key
                - apiKey
              key_in_header: true
              key_in_query: false
              hide_credentials: false
              anonymous: "anonymous-consumer"
          - name: request-transformer
            config:
              add:
                headers:
                  - "X-Kong-Route:ai-gateway"
                  - "X-Service-Name:ai-gateway"

  # Sales Agent — ruta pública (prospectos sin cuenta)
  # IMPORTANTE: debe declararse ANTES de ai-gateway-route para que Kong
  # aplique primero esta ruta más específica.
  - name: ai-sales-public-service
    url: http://mc-commerce-ai-service:8000
    connect_timeout: 60000
    write_timeout: 120000
    read_timeout: 120000
    routes:
      - name: ai-sales-chat-public-route
        paths:
          - /ai/sales/chat
          - /ai/sales/health
        strip_path: false
        protocols:
          - http
          - https
        plugins:
          - name: request-transformer
            config:
              add:
                headers:
                  - "X-Kong-Route:ai-sales-public"
                  - "X-Service-Name:ai-gateway"

  # Frontend Backoffice
  - name: backoffice-frontend
    url: http://mc-backoffice:3000
    routes:
      - name: backoffice-frontend-route
        paths:
          - /backoffice/
        strip_path: true

  # AI Gateway -> PIM Service (ruta dedicada)
