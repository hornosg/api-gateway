_format_version: "3.0"
_transform: true

services:
  # Servicio IAM
  - name: iam-service
    url: http://mc-iam-service:8080
    routes:
      - name: iam-route
        paths:
          - /iam/
        strip_path: true

  # K2 (ADR-003a) — LOGIN público (anti fuerza bruta).
  # FIX 2026-06-19: antes este route colgaba de iam-service (url SIN path) con
  # strip_path:true → Kong strippeaba el path COMPLETO y el upstream recibía "POST /"
  # (→ "Authorization header required": login ROTO por el gateway). Lo introdujo #233 al
  # scopear el rate-limit sin seguir el patrón documentado de pim-s2s-reclassify-service.
  # AHORA es un SERVICE dedicado con la URL upstream COMPLETA (mismo patrón, ver líneas
  # de pim-s2s-reclassify): strip_path:true deja el upstream EXACTO /api/v1/auth/login.
  # Al ser service propio NO hereda el jwt+acl de iam-service → login público (correcto:
  # todavía no hay token). El rate-limiting K2 (5/min, limit_by:ip, policy:local) queda igual.
  - name: iam-auth-login-service
    url: http://mc-iam-service:8080/api/v1/auth/login
    routes:
      - name: iam-auth-login-route
        paths:
          - /iam/api/v1/auth/login
        strip_path: true
        methods:
          - POST
        plugins:
          - name: rate-limiting
            config:
              minute: 5
              hour: 100
              limit_by: ip
              policy: local

  # K2 (ADR-003a) — REFRESH público. Mismo fix/patrón que login (service dedicado con
  # URL upstream completa). Más holgado: 30/min (tráfico de máquina, varias sesiones tras NAT).
  - name: iam-auth-refresh-service
    url: http://mc-iam-service:8080/api/v1/auth/refresh
    routes:
      - name: iam-auth-refresh-route
        paths:
          - /iam/api/v1/auth/refresh
        strip_path: true
        methods:
          - POST
        plugins:
          - name: rate-limiting
            config:
              minute: 30
              hour: 600
              limit_by: ip
              policy: local

  # Servicio PIM
  - name: pim-service
    url: http://mc-pim-service:8090
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: pim-route
        paths:
          - /pim/
        strip_path: true

  # Servicio PIM S2S (comunicación interna, API-Key auth, sin JWT)
  - name: pim-s2s-service
    url: http://mc-pim-service:8090/api/v1/s2s
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: pim-s2s-route
        paths:
          - /pim/api/v1/s2s/
        strip_path: true
        methods:
          - POST
          - GET
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-API-Key
              hide_credentials: true
          - name: acl
            config:
              allow:
                - "service-internal"
              hide_groups_header: true

  # Servicio PIM S2S — Reclasificación masiva (route dedicado con rate-limit restrictivo)
  # Mutación global pesada: UPDATE masivo sobre global_products (hasta 50k filas) + snapshot por apply.
  # Service propio con la URL upstream completa (incluye el path /api/v1/s2s/global-products/...):
  # así strip_path:true puede strippar el path completo del request y el upstream queda IDÉNTICO
  # al del route genérico (pim recibe POST /api/v1/s2s/global-products/reclassify-business-types).
  # Kong prioriza este route sobre pim-s2s-route porque su path es un prefijo más largo (match más específico).
  - name: pim-s2s-reclassify-service
    url: http://mc-pim-service:8090/api/v1/s2s/global-products/reclassify-business-types
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: pim-s2s-reclassify-route
        paths:
          - /pim/api/v1/s2s/global-products/reclassify-business-types
        strip_path: true
        methods:
          - POST
        plugins:
          # Auth replicada del route genérico (NO se hereda: es otro service/route).
          - name: key-auth
            config:
              key_names:
                - X-API-Key
              hide_credentials: true
          - name: acl
            config:
              allow:
                - "service-internal"
              hide_groups_header: true
          # Rate-limiting RESTRICTIVO: es una operación de operador humano, no tráfico máquina.
          # 5/min, 30/hora: permite reintentos puntuales y una sesión de trabajo razonable,
          # pero corta abuso/loops accidentales sobre un UPDATE de hasta 50k filas + snapshot.
          # policy: redis (lab-redis) — primer rate-limit redis del template: el límite se comparte
          # entre réplicas de Kong (a diferencia de policy:local), correcto para un tope global de la op.
          - name: rate-limiting
            config:
              minute: 5
              hour: 30
              policy: redis
              redis_host: lab-redis
              redis_port: 6379
              # lab-redis (redis:7-alpine) sin requirepass ni db selection: host+port alcanza.
              # fault_tolerant: false (fail-CLOSED) — dictamen @dev-security gate L4 E24/PR-4:
              # el rate-limit contiene daño de una mutación global destructiva (UPDATE 50k + snapshot);
              # si redis cae, mejor 500 que permitir martillar la op sin tope. No es QoS, es contención.
              fault_tolerant: false

  # Servicio Stock
  - name: stock-service
    url: http://mc-stock-service:8080
    routes:
      - name: stock-route
        paths:
          - /stock/
        strip_path: true

  # Servicio Catalog BFF (HITO 1 - Orquestación)
  - name: catalog-bff-service
    url: http://mc-catalog-bff-service:8085
    routes:
      - name: catalog-route
