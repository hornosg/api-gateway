        strip_path: true

  # AI Gateway -> PIM Service (ruta dedicada)
  - name: ai-gateway-pim-service
    url: http://mc-pim-service:8090
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: ai-gateway-pim-route
        paths:
          - /ai-gateway/pim/
        strip_path: true

  # Webdata Service (Web Data Layer - Firecrawl)
  - name: webdata-service
    url: http://mc-webdata-service:8150
    connect_timeout: 60000
    write_timeout: 120000
    read_timeout: 120000
    routes:
      - name: webdata-route
        paths:
          - /webdata/
        strip_path: true

  # =========================================================================
  # RUTAS INTERNAS S2S (Service-to-Service) — Autenticación por API Key
  # =========================================================================

  # S2S: Stock Service (interno)
  - name: internal-stock-service
    url: http://mc-stock-service:8080
    routes:
      - name: internal-stock-route
        paths:
          - /internal/stock/
        strip_path: true

  # S2S: PIM Service (interno)
  - name: internal-pim-service
    url: http://mc-pim-service:8090
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: internal-pim-route
        paths:
          - /internal/pim/
        strip_path: true

  # S2S: Customer Service (interno)
  - name: internal-customer-service
