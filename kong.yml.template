    url: http://mc-customer-service:8080
    routes:
      - name: internal-customer-route
        paths:
          - /internal/customers/
        strip_path: true

  # S2S: Tenant Service (interno)
  - name: internal-tenant-service
    url: http://mc-tenant-service:8120
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: internal-tenant-route
        paths:
          - /internal/tenant/
        strip_path: true

  # S2S: IAM Service (interno)
  - name: internal-iam-service
    url: http://mc-iam-service:8080
    routes:
      - name: internal-iam-route
        paths:
          - /internal/iam/
        strip_path: true

  # S2S: Notification Service (interno)
  - name: internal-notification-service
    url: http://mc-notification-service:8282
    routes:
      - name: internal-notification-route
        paths:
          - /internal/notification/
        strip_path: true

consumers:
  # Consumer para JWT autenticado
  - username: iam-service-consumer
    jwt_secrets:
      - key: "iam-service"
        algorithm: "HS256"
        secret: "${JWT_SECRET}"
    acls:
      - group: "authenticated"

  # Consumer anónimo para rutas públicas
  - username: anonymous-consumer
    acls:
      - group: "public-routes"

  # Consumer para AI Gateway con API Key (comunicación interna y ACL)
  - username: ai-gateway-consumer
    custom_id: ai-gateway
    keyauth_credentials:
      - key: "${AI_GATEWAY_API_KEY}"
    acls:
      - group: "ai-gateway-access"
      - group: "authenticated"
  
  # Consumer para Marketplace Admin (operaciones globales)
  - username: marketplace-admin-consumer
    keyauth_credentials:
      - key: "${MARKETPLACE_ADMIN_API_KEY}"
    acls:
      - group: "marketplace-admin"
      - group: "authenticated"

  # Consumer para Onboarding Service (comunicación interna S2S)
  - username: onboarding-service-consumer
    custom_id: onboarding-service
    keyauth_credentials:
      - key: "${ONBOARDING_SERVICE_API_KEY}"
    acls:
      - group: "service-internal"
      - group: "authenticated"

  # Consumer para Sales Service (comunicación interna S2S)
  - username: sales-service-consumer
    custom_id: sales-service
    keyauth_credentials:
      - key: "${SALES_SERVICE_API_KEY}"
    acls:
      - group: "service-internal"
      - group: "authenticated"

  # Consumer para Catalog BFF Service (comunicación interna S2S)
  - username: catalog-bff-consumer
    custom_id: catalog-bff-service
    keyauth_credentials:
      - key: "${CATALOG_BFF_API_KEY}"
    acls:
      - group: "service-internal"
      - group: "authenticated"

  # Consumer para PIM S2S (refresh template products, comunicación interna)
  - username: pim-s2s-consumer
    custom_id: pim-s2s
    keyauth_credentials:
      - key: "${PIM_S2S_API_KEY}"
    acls:
      - group: "service-internal"

plugins:
  # Plugin global de CORS
  - name: cors
    config:
      origins:
        __CORS_ORIGINS_PLACEHOLDER__
      methods:
        - GET
        - POST
        - PUT
        - PATCH
        - DELETE
        - OPTIONS
      headers:
        - Authorization
        - Content-Type
        - X-Tenant-ID
        - X-Refresh-Token
        - X-User-Role
        - X-Request-ID
        - X-API-Key
      exposed_headers:
        - X-Auth-Token
        - X-Request-ID
        - X-LLM-Cost
        - X-LLM-Input-Tokens
        - X-LLM-Output-Tokens
      credentials: true
      max_age: 3600

  # Plugin global de Request Size Limiting (5MB default, servicios específicos lo sobreescriben)
  - name: request-size-limiting
    config:
      allowed_payload_size: 5

  # Plugin JWT para autenticación
  - name: jwt
    service: iam-service
    config:
      header_names:
        - Authorization
      claims_to_verify:
        - exp
      key_claim_name: iss
      secret_is_base64: false
      run_on_preflight: false
      uri_param_names:
        - jwt
      anonymous: "anonymous-consumer"

  # Plugin JWT para el servicio PIM
  - name: jwt
    service: pim-service
    config:
      header_names:
        - Authorization
      claims_to_verify:
        - exp
      key_claim_name: iss
      secret_is_base64: false
      run_on_preflight: false
      uri_param_names:
        - jwt
      anonymous: "anonymous-consumer"

