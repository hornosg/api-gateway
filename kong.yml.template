  # Plugin Rate Limiting para Webdata Service
  - name: rate-limiting
    service: webdata-service
    config:
      minute: 200
      hour: 2000
      policy: local

  # Plugin Rate Limiting para Onboarding
  - name: rate-limiting
    service: onboarding-service
    config:
      minute: 100
      hour: 2000
      policy: local

  # Plugin Rate Limiting para Notification
  - name: rate-limiting
    service: notification-service
    config:
      minute: 60
      hour: 1000
      policy: local

  # Plugin Rate Limiting para Tenant
  - name: rate-limiting
    service: tenant-service
    config:
      minute: 100
      hour: 2000
      policy: local

  # Plugin Key Auth para AI Gateway -> PIM
  - name: key-auth
    service: ai-gateway-pim-service
    config:
      key_names:
        - apikey
        - X-API-Key
      hide_credentials: true

  # Plugin ACL para AI Gateway -> PIM
  - name: acl
    service: ai-gateway-pim-service
    config:
      allow:
        - "ai-gateway-access"
      hide_groups_header: true

  # Plugin Rate Limiting para AI Gateway -> PIM (más permisivo)
  - name: rate-limiting
    service: ai-gateway-pim-service
    config:
      minute: 300
      hour: 3000
      policy: local

  # Plugin Request Size Limiting para AI Gateway -> PIM (para batch operations)
  - name: request-size-limiting
    service: ai-gateway-pim-service
    config:
      allowed_payload_size: 50

  # =========================================================================
  # PLUGINS S2S — Rutas internas (key-auth + ACL + rate-limiting)
  # =========================================================================

  # Key Auth para rutas internas S2S
  - name: key-auth
    service: internal-stock-service
    config:
      key_names:
        - X-API-Key
      key_in_header: true
      key_in_query: false
      hide_credentials: true

  - name: key-auth
    service: internal-pim-service
    config:
      key_names:
        - X-API-Key
      key_in_header: true
      key_in_query: false
      hide_credentials: true

  - name: key-auth
    service: internal-customer-service
    config:
      key_names:
        - X-API-Key
      key_in_header: true
      key_in_query: false
      hide_credentials: true

  - name: key-auth
    service: internal-tenant-service
    config:
      key_names:
        - X-API-Key
      key_in_header: true
      key_in_query: false
      hide_credentials: true

  - name: key-auth
    service: internal-iam-service
    config:
      key_names:
        - X-API-Key
      key_in_header: true
      key_in_query: false
      hide_credentials: true

  - name: key-auth
    service: internal-notification-service
    config:
      key_names:
        - X-API-Key
      key_in_header: true
      key_in_query: false
      hide_credentials: true

  # ACL para rutas internas S2S (solo service-internal)
  - name: acl
    service: internal-stock-service
    config:
      allow:
        - "service-internal"
      hide_groups_header: true

  - name: acl
    service: internal-pim-service
    config:
      allow:
        - "service-internal"
      hide_groups_header: true

  - name: acl
    service: internal-customer-service
    config:
      allow:
        - "service-internal"
      hide_groups_header: true

  - name: acl
    service: internal-tenant-service
    config:
      allow:
        - "service-internal"
      hide_groups_header: true

  - name: acl
    service: internal-iam-service
    config:
      allow:
        - "service-internal"
      hide_groups_header: true

  - name: acl
    service: internal-notification-service
    config:
      allow:
        - "service-internal"
      hide_groups_header: true

  # Rate Limiting para rutas internas S2S (más permisivo)
  - name: rate-limiting
    service: internal-stock-service
    config:
      minute: 1000
      hour: 20000
      policy: local

  - name: rate-limiting
    service: internal-pim-service
    config:
      minute: 1000
      hour: 20000
      policy: local

  - name: rate-limiting
    service: internal-customer-service
    config:
      minute: 1000
      hour: 20000
      policy: local

  - name: rate-limiting
    service: internal-tenant-service
    config:
      minute: 1000
      hour: 20000
      policy: local

  - name: rate-limiting
    service: internal-iam-service
    config:
      minute: 1000
      hour: 20000
      policy: local

  - name: rate-limiting
    service: internal-notification-service
    config:
      minute: 1000
      hour: 20000
      policy: local

  # Request Transformer para rutas internas S2S (inyectar headers de trazabilidad)
  - name: request-transformer
    service: internal-stock-service
    config:
      add:
        headers:
          - "X-Kong-Route:internal"
          - "X-Service-Origin:s2s"

  - name: request-transformer
    service: internal-pim-service
    config:
      add:
        headers:
          - "X-Kong-Route:internal"
          - "X-Service-Origin:s2s"

  - name: request-transformer
    service: internal-customer-service
    config:
      add:
        headers:
          - "X-Kong-Route:internal"
          - "X-Service-Origin:s2s"

  - name: request-transformer
    service: internal-tenant-service
    config:
      add:
        headers:
          - "X-Kong-Route:internal"
          - "X-Service-Origin:s2s"

  - name: request-transformer
    service: internal-iam-service
    config:
      add:
        headers:
          - "X-Kong-Route:internal"
          - "X-Service-Origin:s2s"

  - name: request-transformer
    service: internal-notification-service
    config:
      add:
        headers:
          - "X-Kong-Route:internal"
          - "X-Service-Origin:s2s"

  # Plugin Prometheus para métricas globales
  - name: prometheus
    config:
      per_consumer: true
      status_code_metrics: true
      latency_metrics: true
      bandwidth_metrics: true
