  # =========================================================================
  # CATALOG SERVICE (PLAT-E39 · T1d) — postura de auth para estos paths.
  # jwt: MISMA verificación que pim (HS256 del consumer iam-service, iss, exp), pero
  # SIN fallback anónimo → a diferencia de pim/marketplace, NO cae al consumer anónimo
  # compartido (D3.3): sin JWT válido, Kong devuelve 401 en el borde (fail-closed).
  # La autz de rol (system_admin) la hace catalog-service dentro del proceso (T1c);
  # el gateway sólo garantiza identidad verificada. ACL: solo "authenticated"
  # (NO "public-routes"), coherente con el fail-closed.
  # =========================================================================
  - name: jwt
    service: catalog-service
    config:
      header_names:
        - Authorization
      claims_to_verify:
        - exp
      key_claim_name: iss
      secret_is_base64: false
      run_on_preflight: false
      uri_param_names:
        - jwt

  - name: acl
    service: catalog-service
    config:
      allow:
        - "authenticated"
      hide_groups_header: true

  - name: rate-limiting
    service: catalog-service
    config:
      minute: 60
      hour: 1000
      policy: local

  # =========================================================================
  # CATALOG PUBLIC SERVICE (PLAT-E39 · T6d · D3.3). Rate limit por IP con policy: redis
  # (no `local`: el catálogo público tiene que respetar el límite multi-nodo). No hay jwt
  # ni acl en este service: la única protección de borde del service público es éste
  # rate-limit + el anclaje de los dos routes regex GET.
  # =========================================================================
  - name: rate-limiting
    service: catalog-public-service
    config:
      minute: 30
      hour: 1000
      limit_by: ip
      policy: redis
      redis_host: lab-redis
      redis_port: 6379
      # lab-redis sin requirepass (redis:7-alpine) — host+port alcanza, igual que el rate-limit
      # redis de E24 línea 137. fault_tolerant: true (fail-OPEN, default de Kong): a diferencia
      # de la mutación destructiva de E24, éste es un GET público de catálogo — si redis cae,
      # mejor servir el catálogo sin tope que 500 a un consumer anónimo. No es contención de
      # daño, es QoS de un read público.
      fault_tolerant: true

