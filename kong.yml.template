_format_version: "3.0"
_transform: true

services:
  # Servicio IAM
  - name: iam-service
    url: http://mc-iam-service:8080
    routes:
      - name: iam-route
        paths:
          - /iam/
        strip_path: true

  # K2 (ADR-003a) — LOGIN público (anti fuerza bruta).
  # FIX 2026-06-19: antes este route colgaba de iam-service (url SIN path) con
  # strip_path:true → Kong strippeaba el path COMPLETO y el upstream recibía "POST /"
  # (→ "Authorization header required": login ROTO por el gateway). Lo introdujo #233 al
  # scopear el rate-limit sin seguir el patrón documentado de service dedicado con URL
  # upstream completa (ver catalog-s2s-service abajo).
  # AHORA es un SERVICE dedicado con la URL upstream COMPLETA (mismo patrón que
  # catalog-s2s-service): strip_path:true deja el upstream EXACTO /api/v1/auth/login.
  # Al ser service propio NO hereda el jwt+acl de iam-service → login público (correcto:
  # todavía no hay token). El rate-limiting K2 (5/min, limit_by:ip, policy:local) queda igual.
  - name: iam-auth-login-service
    url: http://mc-iam-service:8080/api/v1/auth/login
    routes:
      - name: iam-auth-login-route
        paths:
          - /iam/api/v1/auth/login
        strip_path: true
        methods:
          - POST
        plugins:
          - name: rate-limiting
            config:
              minute: 5
              hour: 100
              limit_by: ip
              policy: local

  # K2 (ADR-003a) — REFRESH público. Mismo fix/patrón que login (service dedicado con
  # URL upstream completa). Más holgado: 30/min (tráfico de máquina, varias sesiones tras NAT).
  - name: iam-auth-refresh-service
    url: http://mc-iam-service:8080/api/v1/auth/refresh
    routes:
      - name: iam-auth-refresh-route
        paths:
          - /iam/api/v1/auth/refresh
        strip_path: true
        methods:
          - POST
        plugins:
          - name: rate-limiting
            config:
              minute: 30
              hour: 600
              limit_by: ip
              policy: local

  # ACC-E09 T2 (ADR-006 «Exposición del endpoint») — emisión del token de servicio S2S: los
  # emisores llegan SOLO directo por lab-network, sin ruta de Kong (revisión L4 de T2, O-1: detrás
  # de Kong todo el tráfico comparte la IP del gateway, así que el cupo pre-auth por IP de iam se
  # agotaba para todos los emisores con un solo cliente anónimo). tests/s2s-token-config.py exige
  # que ninguna ruta pública alcance /api/v1/s2s/token y traba el bloqueo de abajo.
  # ACC-E09 T2 — la ruta pública /iam/ NO alcanza el endpoint de emisión: todo /iam/api/v1/s2s
  # termina en el borde con 404, sin upstream. Más específica que el catch-all /iam/, gana el
  # matcheo para cualquier método.
  - name: iam-s2s-block-service
    url: http://mc-iam-service:8080
    routes:
      - name: iam-s2s-block-route
        paths:
          - /iam/api/v1/s2s
          - /internal/iam/api/v1/s2s
        strip_path: false
        plugins:
          - name: request-termination
            config:
              status_code: 404
              message: "Not Found"

  # Servicio PIM
  - name: pim-service
    url: http://mc-pim-service:8090
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: pim-route
        paths:
          - /pim/
        strip_path: true

  # Servicio Stock
  - name: stock-service
    url: http://mc-stock-service:8080
    routes:
      - name: stock-route
        paths:
          - /stock/
        strip_path: true

  # Servicio Catalog BFF (HITO 1 - Orquestación)
  - name: catalog-bff-service
    url: http://mc-catalog-bff-service:8085
    routes:
      - name: catalog-route
        paths:
          - /catalog/
        strip_path: true
      # Admin BFF — rutas de backoffice que proxean a PIM con audit de operador.
      - name: admin-bff-route
        paths:
          - /admin/
        strip_path: true

  # ACC-E03 T5c (2026-10-17) — rutas PÚBLICAS del BFF, carvadas en un service dedicado.
  # catalog-bff-service quedó con jwt SIN `anonymous` (borde estricto): un JWT inválido da 401
  # en Kong sin llegar al upstream. Las dos únicas rutas anónimas del BFF (árbol público de
  # categorías de marketplace, que proxean al endpoint público de catalog-service sin token)
  # viven acá, sin jwt/ACL — mismo patrón que catalog-public-service e iam-auth-login-service
  # (service propio con URL upstream completa → no hereda el jwt del service base).
  # Regex anclado con `$` + `methods:[GET]`: sólo `/categories` y `/categories/tree`; nada
  # más del BFF (ni `/admin/`, ni POST/PUT, ni `/categories/<id>`) matchea.
  - name: catalog-bff-public-service
    url: http://mc-catalog-bff-service:8085
    routes:
      - name: catalog-bff-public-categories-route
        paths:
          - "~/catalog(/api/v1/marketplace/categories(?:/tree)?)$"
        strip_path: false
        methods:
          - GET
        plugins:
          - name: request-transformer
            config:
              replace:
                uri: "$(uri_captures[1])"
          # Mismo límite que catalog-public-service (security T5c O2): ruta anónima = por IP, redis.
          - name: rate-limiting
            config:
              minute: 30
              hour: 1000
              limit_by: ip
              policy: redis
              redis_host: lab-redis
              redis_port: 6379
              fault_tolerant: true

  # Servicio Sales - HITO v0.5 (HTTP Routes Alignment)
  - name: sales-service
    url: http://sales-service:8080
    routes:
      - name: sales-route
        paths:
          - /sales/
        strip_path: true

  # Customer Service (POS-SALE-02)
  - name: customer-service
    url: http://mc-customer-service:8080
    routes:
      - name: customer-route
        paths:
          - /customers/
        strip_path: true

  # Ledger Service (PLAT-E02)
  - name: ledger-service
    url: http://mc-ledger-service:8120
    routes:
      - name: ledger-route
        paths:
          - /ledger/
        strip_path: true

  # Payment Method Service (POS-SALE-02)
  - name: payment-method-service
    url: http://mc-payment-method-service:8080
    routes:
      - name: payment-method-route
        paths:
          - /payment-methods/
        strip_path: true

  # Servicio Marketplace (funcionalidad dentro del PIM)
  - name: marketplace-service
    url: http://mc-pim-service:8090/api/v1
    routes:
      - name: marketplace-route
        paths:
          - /marketplace/
        strip_path: false
  # Servicio Onboarding
  - name: onboarding-service
    url: http://mc-onboarding-service:8110/api/v1/onboarding
    routes:
      - name: onboarding-route
        paths:
          - /onboarding/api/v1/
        strip_path: true

  # Servicio Notification
  - name: notification-service
    url: http://mc-notification-service:8282
    routes:
      - name: notification-route
        paths:
          - /notification/
        strip_path: true

  # Servicio Tenant (Configuración por Tenant)
  - name: tenant-service
    url: http://mc-tenant-service:8120
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: tenant-route
        paths:
          - /tenant
        strip_path: true
      # Ruta específica para bootstrap (solo servicios internos)
      - name: tenant-bootstrap-route
        paths:
          - /tenant/api/v1/tenant/bootstrap
        strip_path: false
        methods:
          - POST
        plugins:
          - name: acl
            config:
              allow:
                - "service-internal"
              hide_groups_header: true

  # Frontend CRM
  - name: crm-frontend
    url: http://frontend-activo-crm:3000
    routes:
      - name: crm-frontend-route
        paths:
          - /crm/
        strip_path: true
  
  # AI Gateway Service (Autenticación flexible: JWT o API Key)
  - name: ai-gateway-service
    url: http://mc-commerce-ai-service:8000
    connect_timeout: 60000
    write_timeout: 120000
    read_timeout: 120000
    retries: 3
    routes:
      - name: ai-gateway-route
        paths:
          - /ai-gateway/
          - /ai/
        strip_path: true
        protocols:
          - http
          - https
        preserve_host: false
        plugins:
          - name: key-auth
            config:
              key_names:
                - X-API-Key
                - apiKey
              key_in_header: true
              key_in_query: false
              hide_credentials: false
              anonymous: "anonymous-consumer"
          - name: request-transformer
            config:
              add:
                headers:
                  - "X-Kong-Route:ai-gateway"
                  - "X-Service-Name:ai-gateway"

  # Sales Agent — ruta pública (prospectos sin cuenta)
  # IMPORTANTE: debe declararse ANTES de ai-gateway-route para que Kong
  # aplique primero esta ruta más específica.
  - name: ai-sales-public-service
    url: http://mc-commerce-ai-service:8000
    connect_timeout: 60000
    write_timeout: 120000
    read_timeout: 120000
    routes:
      - name: ai-sales-chat-public-route
        paths:
          - /ai/sales/chat
          - /ai/sales/health
        strip_path: false
        protocols:
          - http
          - https
        plugins:
          - name: request-transformer
            config:
              add:
                headers:
                  - "X-Kong-Route:ai-sales-public"
                  - "X-Service-Name:ai-gateway"

  # Frontend Backoffice
  - name: backoffice-frontend
    url: http://mc-backoffice:3000
    routes:
      - name: backoffice-frontend-route
        paths:
