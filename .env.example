# API Gateway — Variables de entorno requeridas
# Copiar a .env y completar con valores reales.

# ACC-E03 T5: clave PÚBLICA RS256 de account-service con la que el plugin jwt verifica los
# tokens de usuario en el borde (credencial `iam-service`, key_claim_name: iss). PEM en una sola
# línea con \n literales — entrypoint.sh la normaliza. Fuente: infra/jwt-keyring/acc-*.pem.
# Nunca la privada: entrypoint.sh no arranca si ve "PRIVATE KEY".
#   awk 'BEGIN{ORS="\\n"} {print}' ../jwt-keyring/acc-<kid>.pem
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<base64 de la pública>\n-----END PUBLIC KEY-----\n

# Secreto HS256 legado: el template ya no lo usa (T5). Se retira de la flota en ACC-E03 T6.
JWT_SECRET=change-me-use-a-long-random-string

# API Keys de consumers internos
AI_GATEWAY_API_KEY=change-me
MARKETPLACE_ADMIN_API_KEY=change-me
SALES_SERVICE_API_KEY=change-me
CATALOG_BFF_API_KEY=change-me
ONBOARDING_SERVICE_API_KEY=change-me
PIM_S2S_API_KEY=change-me
PIM_CATALOG_S2S_API_KEY=cambiar-pim-catalog-s2s-key-en-vault

# Orígenes CORS permitidos (separados por coma, sin espacios)
CORS_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3005,http://localhost:3010,http://localhost:3011,http://localhost:3012
