# API Gateway — Variables de entorno requeridas
# Copiar a .env y completar con valores reales.

# Secret para firmar/validar JWTs (debe coincidir con IAM_SERVICE_JWT_SECRET en iam-service)
JWT_SECRET=change-me-use-a-long-random-string

# API Keys de consumers internos
AI_GATEWAY_API_KEY=change-me
MARKETPLACE_ADMIN_API_KEY=change-me
SALES_SERVICE_API_KEY=change-me
CATALOG_BFF_API_KEY=change-me
ONBOARDING_SERVICE_API_KEY=change-me
PIM_S2S_API_KEY=change-me

# Orígenes CORS permitidos (separados por coma, sin espacios)
CORS_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3005
